{
  "name": "terminal-personal-website",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build --force && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "test:build": "node --test tests/build/content.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:browser": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "test:caddy": "node --test tests/server/caddy.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.12",
    "@shikijs/core": "^4.5.0",
    "astro": "^7.3.5",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "subset-font": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
