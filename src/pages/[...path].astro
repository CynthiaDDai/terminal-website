---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import ContentList from '../components/content/ContentList.astro';
import { getContentTree } from '../lib/navigation/site-index';
import { virtualPath } from '../lib/navigation/filesystem';
import type { ContentNode } from '../lib/content/tree';

export async function getStaticPaths() {
  return (await getContentTree()).nodes.filter(node => node.path !== '/')
    .map(node => ({ params: { path: node.path.slice(1) }, props: { node } }));
}

interface Props { node: ContentNode; }
const { node } = Astro.props;
const document = node.kind === 'page' ? node : node.index.source === 'explicit' ? node.index.document : undefined;
const entry = document ? await getEntry('content', document.sourceId) : undefined;
if (document && !entry) throw new Error(`Missing content document: ${document.sourcePath}`);
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const tree = await getContentTree();
const children = node.kind === 'directory' ? node.children : [];
// Documents always use the article layout, wherever they live; directories use the page layout.
const parentTitle = tree.nodes.find(parent => parent.path === node.parentPath)?.title ?? 'Home';
---
{node.kind === 'directory' ? <PageLayout title={node.title} description={node.description} eyebrow={virtualPath(node.path)} motto={node.frontmatter.motto} wide>
  {Content && <div class="prose"><Content /></div>}
  {node.frontmatter.show_children !== false && children.length > 0 && <ContentList entries={children} groups={node.frontmatter.groups} />}
</PageLayout> : entry && rendered && Content && <ArticleLayout {...entry.data} title={node.title} description={node.description} tags={node.tags} headings={rendered.headings} parentTitle={parentTitle}>
  <Content />
</ArticleLayout>}
