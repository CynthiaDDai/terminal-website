---
import EdgeLinks from './EdgeLinks.astro';
import Motto from '../content/Motto.astro';
import { site } from '../../config';
interface Props { path: string; }
const { path } = Astro.props;
---
<aside class="edge-navigation">
  <div class="edge-menu">
    <button class="edge-handle" type="button" data-toggle-edge aria-label="Explore the site" aria-expanded="false" aria-controls="desktop-edge-links"><Motto text={site.mottos?.index} class="edge-motto" /><span class="edge-label">index</span><span class="edge-mark" aria-hidden="true">+</span></button>
    <nav id="desktop-edge-links" aria-label="Explore the site"><EdgeLinks path={path} /></nav>
  </div>
</aside>
