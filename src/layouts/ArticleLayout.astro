---
import BaseLayout from './BaseLayout.astro';
import TopNav from '../components/nav/TopNav.astro';
import CommandBar from '../components/shell/CommandBar.astro';
import type { MarkdownHeading } from 'astro';
import { normalizePath, pathFromUrl } from '../lib/navigation/filesystem';
import { site } from '../config';
import SiteFooter from '../components/nav/SiteFooter.astro';
import Paired from '../components/content/Paired.astro';
interface Props {
  title: string; description: string; date?: Date; updated?: Date; tags: string[];
  example?: boolean; headings: MarkdownHeading[]; parentTitle: string; status?: string; repo?: string; demo?: string;
  authors?: string; venue?: string; links?: Record<string, string>; motto?: string;
}
const { title, description, date, updated, tags, example, headings, parentTitle, status, repo, demo, authors, venue, links = {}, motto } = Astro.props;
const path = pathFromUrl(Astro.url.pathname);
const parentPath = normalizePath('..', path);
const linkList = Object.entries(links);
// Sections (##) with their subsections (###), drawn as a tree. Footnotes get a generated heading; it is not a section.
const sections = headings.filter(heading => heading.depth <= 3 && heading.depth >= 2 && heading.slug !== 'footnote-label')
  .reduce<{ heading: MarkdownHeading; children: MarkdownHeading[] }[]>((tree, heading) => {
    if (heading.depth === 3 && tree.length) tree.at(-1)!.children.push(heading);
    else tree.push({ heading, children: [] });
    return tree;
  }, []);
const tocSize = sections.reduce((size, section) => size + 1 + section.children.length, 0);
const formatDate = (value: Date) => value.toLocaleDateString(site.dateLocale, { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={title} description={description} article>
  <TopNav path={path} />
  <main id="main" class="article-main" tabindex="-1">
    <CommandBar path={path} />
    <article>
      <header class="article-heading">
        <h1><Paired text={title} motto={motto} /></h1>
        {authors && <p class="article-byline">{authors}</p>}
        {description && <p class="article-deck">{description}</p>}
        <div class="article-meta">{date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}{status && <span class="status">{status}</span>}{venue && <span>{venue}</span>}{example && <span class="example-label">Example content</span>}</div>
        {tags.length > 0 && <ul class="tag-list" aria-label="Tags">{tags.map(tag => <li>{tag}</li>)}</ul>}
        {(repo || demo || linkList.length > 0) && <div class="project-links">{repo && <a href={repo}>Source code ↗</a>}{demo && <a href={demo}>Visit project ↗</a>}{linkList.map(([label, url]) => <a href={url}>{label}{/^https?:/.test(url) && ' ↗'}</a>)}</div>}
      </header>
      {tocSize >= 2 && <nav class="toc" aria-label="Table of contents"><div class="toc-body">
        <p class="toc-label" aria-hidden="true"><Paired text="on this page" motto={site.mottos?.toc} /></p>
        <ol>{sections.map(({ heading, children }, index) => {
          const last = index === sections.length - 1;
          return <li><a href={`#${heading.slug}`}><span class="toc-branch" aria-hidden="true">{last ? '└' : '├'}</span><span>{heading.text}</span></a>
            {children.length > 0 && <ol>{children.map((child, childIndex) => <li><a href={`#${child.slug}`}><span class="toc-branch" aria-hidden="true">{last ? ' ' : '│'} {childIndex === children.length - 1 ? '└' : '├'}</span><span>{child.text}</span></a></li>)}</ol>}
          </li>;
        })}</ol>
      </div></nav>}
      <div class="prose"><slot /></div>
      {updated && <p class="updated">Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></p>}
    </article>
    <div class="article-bottom"><a href={parentPath}>← Back to {parentTitle}</a><a href="#main">Back to top ↑</a></div>
  </main>
  <SiteFooter path={path} />
</BaseLayout>
