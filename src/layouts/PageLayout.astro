---
import BaseLayout from './BaseLayout.astro';
import TopNav from '../components/nav/TopNav.astro';
import CommandBar from '../components/shell/CommandBar.astro';
import SiteFooter from '../components/nav/SiteFooter.astro';
import Paired from '../components/content/Paired.astro';
import { pathFromUrl } from '../lib/navigation/filesystem';
interface Props { title: string; description?: string; eyebrow?: string; wide?: boolean; motto?: string; quote?: string; }
const { title, description, eyebrow, wide = false, motto, quote } = Astro.props;
const path = pathFromUrl(Astro.url.pathname);
---
<BaseLayout title={title} description={description}>
  <TopNav path={path} />
  <main id="main" class:list={['page-main', wide && 'wide']} tabindex="-1">
    <CommandBar path={path} />
    <div class="page-intro">
      {eyebrow && !eyebrow.startsWith('~/') && <p class="eyebrow">{eyebrow}</p>}
      <h1><Paired text={title} motto={motto} /></h1>
      {description && <p class="page-description">{description}</p>}
    </div>
    <slot />
  </main>
  <SiteFooter path={path} quote={quote} />
</BaseLayout>
